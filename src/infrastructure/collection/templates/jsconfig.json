{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": false,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./lib/node_modules/@types"
    ]
  },
  "include": [
    "**/*.js",
    "**/*.d.ts"
  ],
  "exclude": [
    "lib/**",
    "node_modules/**"
  ]
}
