{
  "name": "@http-forge/core",
  "version": "1.0.1",
  "description": "Headless Postman-compatible API testing engine for Node.js, CI/CD, OpenAPI workflows, and HTTP Forge automation",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && node esbuild.config.js",
    "build:prod": "npm run clean && node esbuild.config.js --production",
    "prepublishOnly": "npm run build:prod",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "clean": "rimraf dist"
  },
  "keywords": [
    "http-forge",
    "http forge",
    "http",
    "api",
    "testing",
    "api testing",
    "postman",
    "postman alternative",
    "postman runtime",
    "openapi",
    "graphql",
    "automation",
    "ci",
    "cd",
    "ci-cd",
    "api engine",
    "collection",
    "headless",
    "headless api testing",
    "nodejs",
    "mcp",
    "mcp server",
    "scripting",
    "variables",
    "cookies",
    "runtime"
  ],
  "author": "Henry Huang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hsl1230/http-forge.core.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.7.3",
    "ajv": "^8.12.0",
    "java-parser": "^3.0.1",
    "lodash": "4.18.1",
    "moment": "^2.30.1",
    "socket.io-client": "^4.8.1",
    "tv4": "^1.3.0",
    "typescript": "^5.3.0",
    "uuid": "^14.0.0",
    "ws": "^8.22.0",
    "yaml": "^2.7.0"
  },
  "peerDependencies": {
    "@1password/sdk": ">=0.1.0",
    "@aws-sdk/client-secrets-manager": ">=3.0.0",
    "@azure/identity": ">=3.0.0",
    "@azure/keyvault-secrets": ">=4.0.0",
    "@google-cloud/secret-manager": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@1password/sdk": {
      "optional": true
    },
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "@azure/keyvault-secrets": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    },
    "@google-cloud/secret-manager": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.0",
    "@types/tv4": "^1.2.33",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1"
  },
  "homepage": "https://github.com/hsl1230/http-forge.core",
  "bugs": {
    "url": "https://github.com/hsl1230/http-forge.core/issues"
  }
}
